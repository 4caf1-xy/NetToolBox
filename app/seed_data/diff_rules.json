    {
      "rule_id": "if_status",
      "label": "接口状态",
      "semantics": "kv",
      "match": "(display\\s+interface\\b|show\\s+interfaces?\\b)",
      "noise": [],
      "variants": [
        {
          "vendor": "huawei",
          "os_family": "vrp5/vrp8",
          "note": "display interface：物理口状态行（Line protocol 行因 key 无数字天然不命中）",
          "line": "(?P<key>[A-Za-z][\\w./:-]*\\d[\\w./:-]*)\\s+current state\\s*:\\s*(?P<value>\\S+)"
        },
        {
          "vendor": "cisco",
          "os_family": "ios",
          "note": "show interfaces：接口首行状态 + line protocol",
          "line": "(?P<key>[A-Za-z][\\w./-]*\\d[\\w./-]*)\\s+is\\s+(?P<value>administratively down|up|down|reset|deleted)\\s*,\\s*line protocol is\\s+(?P<lp>up|down)"
        },
        {
          "vendor": "h3c",
          "os_family": "comware7",
          "note": "display interface brief：Link 列（值组大小写敏感锁大写——Comware 打印 UP/DOWN，避免吃到 Juniper 等小写 up 输出）",
          "line": "(?P<key>[A-Za-z][\\w/-]*\\d[\\w/-]*)\\s+(?P<value>(?-i:UP|DOWN|DOWN\\s*\\(a\\)|Admin-s))\\s{2,}"
        },
        {
          "vendor": "ruijie",
          "os_family": "rgos",
          "note": "show interfaces：与思科同构",
          "line": "(?P<key>[A-Za-z][\\w./-]*\\d[\\w./-]*)\\s+is\\s+(?P<value>administratively down|up|down|reset|deleted)\\s*,\\s*line protocol is\\s+(?P<lp>up|down)"
        },
        {
          "vendor": "juniper",
          "os_family": "junos",
          "note": "show interfaces terse：物理口行（unit 行带地址不以 up down 结尾，天然排除）",
          "line": "(?P<key>[a-z][\\w./:-]*\\d[\\w./:-]*)\\s+(?P<value>up|down)\\s+(?P<lp>up|down)\\s*$"
