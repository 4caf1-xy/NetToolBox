          "vendor": "huawei",
          "os_family": "vrp5/vrp8",
          "note": "display ospf peer brief：Area + 接口 + 邻居 ID + State",
          "line": "(?P<area>\\d{1,3}(?:\\.\\d{1,3}){3})\\s+\\S+\\s+(?P<key>\\d{1,3}(?:\\.\\d{1,3}){3})\\s+(?P<value>Down|Init|Attempt|2-?Way|ExStart|Exchange|Loading|Full)\\s*$"
        },
        {
          "vendor": "h3c",
          "os_family": "comware7",
          "note": "display ospf peer brief：与华为 brief 同构",
          "line": "(?P<area>\\d{1,3}(?:\\.\\d{1,3}){3})\\s+\\S+\\s+(?P<key>\\d{1,3}(?:\\.\\d{1,3}){3})\\s+(?P<value>Down|Init|Attempt|2-?Way|ExStart|Exchange|Loading|Full)\\s*$"
        },
        {
          "vendor": "cisco",
          "os_family": "ios",
          "note": "show ip ospf neighbor：Neighbor ID + State（FULL/DR 只取 / 前状态）",
          "line": "(?P<key>\\d{1,3}(?:\\.\\d{1,3}){3})\\s+\\d+\\s+(?P<value>DOWN|ATTEMPT|INIT|2WAY|EXSTART|EXCHANGE|LOADING|FULL)\\b(?:/\\S+)?"
        },
        {
          "vendor": "ruijie",
          "os_family": "rgos",
          "note": "show ip ospf neighbor：与思科同构",
          "line": "(?P<key>\\d{1,3}(?:\\.\\d{1,3}){3})\\s+\\d+\\s+(?P<value>DOWN|ATTEMPT|INIT|2WAY|EXSTART|EXCHANGE|LOADING|FULL)\\b(?:/\\S+)?"
        }
      ]
    },
    {
      "rule_id": "route_table",
      "label": "路由表摘要",
      "semantics": "kv",
      "match": "(display\\s+ip\\s+routing-table|show\\s+ip\\s+route\\b|ip\\s+route\\s+(?:show|list))",
      "noise": [],
      "variants": [
        {
          "vendor": "huawei",
          "os_family": "vrp5/vrp8",
          "note": "display ip routing-table：前缀 + 协议（可带 NextHop）",
          "line": "^\\s*(?P<key>\\d{1,3}(?:\\.\\d{1,3}){3}(?:/\\d{1,2})?)\\s+(?P<value>Direct|Static|OSPF|RIP|BGP|IS-IS|UNR)\\b(?:\\s+\\d+\\s+\\d+\\s+\\S+\\s+(?P<via>\\d{1,3}(?:\\.\\d{1,3}){3}))?"
        },
        {
          "vendor": "h3c",
          "os_family": "comware7",
          "note": "display ip routing-table：与华为同构",
          "line": "^\\s*(?P<key>\\d{1,3}(?:\\.\\d{1,3}){3}(?:/\\d{1,2})?)\\s+(?P<value>Direct|Static|OSPF|RIP|BGP|IS-IS|UNR)\\b(?:\\s+\\d+\\s+\\d+\\s+\\S+\\s+(?P<via>\\d{1,3}(?:\\.\\d{1,3}){3}))?"
        },
        {
          "vendor": "cisco",
          "os_family": "ios",
          "note": "show ip route：路由码列（C/S/O/B/L/R，含 IA/E1/E2/N1/N2 修饰），可带 via 下一跳（下一跳变更要能报 ⚠）",
          "line": "^\\s*(?P<value>[CDSOLBRE]\\*?(?:\\s+(?:IA|E1|E2|N1|N2|L1|L2))?)\\s+(?P<key>\\d{1,3}(?:\\.\\d{1,3}){3}(?:/\\d{1,2})?)\\b(?:\\s+\\[[^\\]]+\\]\\s+via\\s+(?P<via>\\d{1,3}(?:\\.\\d{1,3}){3}))?"
        },
        {
          "vendor": "ruijie",
          "os_family": "rgos",
          "note": "show ip route：与思科同构",
          "line": "^\\s*(?P<value>[CDSOLBRE]\\*?(?:\\s+(?:IA|E1|E2|N1|N2|L1|L2))?)\\s+(?P<key>\\d{1,3}(?:\\.\\d{1,3}){3}(?:/\\d{1,2})?)\\b(?:\\s+\\[[^\\]]+\\]\\s+via\\s+(?P<via>\\d{1,3}(?:\\.\\d{1,3}){3}))?"
        },
        {
          "vendor": "linux",
          "os_family": "-",
          "note": "ip route show：default/前缀 + via/dev（metric 等瞬态不入状态值）",
          "line": "^(?P<key>default|\\d{1,3}(?:\\.\\d{1,3}){3}(?:/\\d{1,2})?)\\s+(?P<value>(?:via\\s+\\S+\\s+)?dev\\s+\\S+)"
        }
      ]
    }
  ]
